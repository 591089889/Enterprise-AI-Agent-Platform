APP_NAME=Enterprise_AI_Agent_Platform
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/database_name
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen
# 可选：qwen（默认）或 ollama
LLM_PROVIDER=qwen
# LLM 生成温度（0.0 - 2.0）
LLM_TEMPERATURE=0.7
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===================== Agent / Tool Calling =====================
# 是否启用 Agent Tool Calling（LLM 可调用内置工具，如 calculator）。
# 关闭后 Agent 退化为纯文本对话（与引入 Tool 之前一致）。
AGENT_TOOL_CALLING_ENABLED=true

# ===================== RAG / Knowledge Base =====================
# 本地知识文档目录（相对 backend/ 或绝对路径）
# 说明：自 Stage 20 起仅供离线自检脚本 `python -m app.rag.build_index` 使用，
#       不在任何运行时链路中；平台正式知识由 Knowledge Base（前端）管理。
KNOWLEDGE_DIR=knowledge
# ChromaDB 持久化目录（相对 backend/ 或绝对路径）
VECTOR_STORE_DIR=.chroma
# ChromaDB Collection 名称
# 说明：正式 RAG 使用「本值 + __kb_{knowledge_base_id}」作为知识库专属 collection 名；
#       不带后缀的默认 collection 自 Stage 20 起不再被运行时使用（默认对话不执行 RAG）。
VECTOR_COLLECTION_NAME=knowledge_chunks
# Embedding Provider：
#   - hash      本地确定性散列嵌入（开发/链路验证，无外部依赖）
#   - ollama    本地 Ollama Embedding（需 Ollama 服务）
#   - dashscope DashScope Text Embedding（需 EMBEDDING_API_KEY）
EMBEDDING_PROVIDER=hash
# Embedding 模型名（dashscope: text-embedding-v4；ollama: nomic-embed-text 等）
EMBEDDING_MODEL=
# DashScope Embedding API Key（EMBEDDING_PROVIDER=dashscope 时必填）
EMBEDDING_API_KEY=your_embedding_api_key
# Embedding Base URL（EMBEDDING_PROVIDER=ollama 时使用，默认 http://localhost:11434）
EMBEDDING_BASE_URL=
# 检索返回 Top K 知识片段
RAG_TOP_K=4
# 文本切分参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
